{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js",
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/(.*)",
      "destination": "/backend/server.js"
    }
  ]
}
